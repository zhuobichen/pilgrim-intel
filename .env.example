# ============================================================
# Pilgrim Intel — 环境变量模板（全仓库一份，按组件分区）
# 复制为 .env 后填入实际值：cp .env.example .env
#
# 说明：本仓库是 monorepo，包含统一引擎 + 多个 legacy 子项目。
#   - 统一引擎 run.py 只读取【仓库根目录】的 .env（DeepSeek + 邮件）。
#   - legacy 子项目（abstract-culture / horizon）单独运行时，各自用
#     load_dotenv() 从【自己的目录】读取 .env。
# 因此下面按组件分区列出变量，请把对应区块复制到对应组件自己的 .env，
# 不要把所有区块都塞进同一个 .env。
# ============================================================

# ──────────────────────────────────────────────
# [统一引擎 · run.py + pilgrim/]（根目录 .env）
# ──────────────────────────────────────────────
# DeepSeek API（AI 日报生成必需）
DEEPSEEK_API_KEY=sk-your-key-here

# 邮件推送（QQ 邮箱）
EMAIL_HOST=smtp.qq.com
EMAIL_PORT=465
EMAIL_USER=your-email@qq.com
EMAIL_PASSWORD=your-smtp-authorization-code
EMAIL_TO=recipient@qq.com

# 可选：其他推送渠道（预留）
# DINGTALK_WEBHOOK=
# DINGTALK_SECRET=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ──────────────────────────────────────────────
# [gamehub]（复用根目录的 DEEPSEEK_API_KEY + EMAIL_*）
# ──────────────────────────────────────────────
# 可选：Steam 新闻信源
STEAM_API_KEY=
STEAM_ID=

# ──────────────────────────────────────────────
# [abstract-culture]（legacy，独立 .env）
# ──────────────────────────────────────────────
# AI 模型配置（必填）—— DeepSeek 走 OpenAI 兼容接口
OPENAI_API_KEY=sk-your-deepseek-key
OPENAI_API_BASE=https://api.deepseek.com/v1

# AI 模型参数
AI_MODEL=deepseek-chat
AI_MAX_TOKENS=4000
AI_TEMPERATURE=0.8

# 数据抓取配置
CRAWLER_TIMEOUT=20
CRAWLER_MAX_CONCURRENCY=6

# 推送配置（可选）
PUSH_TYPE=none
SERVERCHAN_KEY=your-key
BARK_KEY=your-key
TELEGRAM_BOT_TOKEN=your-token
TELEGRAM_CHAT_ID=your-chat-id
DINGTALK_WEBHOOK=your-webhook
DINGTALK_SECRET=your-secret

# ──────────────────────────────────────────────
# [horizon]（legacy，独立 .env）
# ──────────────────────────────────────────────
# AI API Keys（至少配置一个）
ANTHROPIC_API_KEY=sk-ant-xxx
OPENAI_API_KEY=sk-xxx
AZURE_OPENAI_API_KEY=xxx
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
GOOGLE_API_KEY=xxx
MINIMAX_API_KEY=xxx
DASHSCOPE_API_KEY=xxx
DOUBAO_API_KEY=xxx
DEEPSEEK_API_KEY=xxx

# WebHook 通知（可选）
HORIZON_WEBHOOK_URL=https://xxx

# GitHub Token（可选但推荐，提高 API 限额）
GITHUB_TOKEN=ghp_xxx

# Apify Token（Twitter 抓取必需）
APIFY_TOKEN=apify_api_xxx
